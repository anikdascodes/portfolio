---
import { getEntry } from 'astro:content';

const about = await getEntry('about', 'about');

if (!about) {
    throw new Error('About content not found');
}

const { Content } = await about.render();
---

<div class="about-content">
    <Content />
</div>

<style>
    .about-content {
        @apply text-gray-300;
    }
    
    /* Header Section */
    .about-content :global(.about-header) {
        @apply mb-8 pb-6 border-b border-gray-800;
    }
    
    .about-content :global(.about-header h1) {
        @apply text-4xl font-bold text-white mb-2;
    }
    
    .about-content :global(.tagline) {
        @apply text-lg text-primary font-medium mb-1;
    }
    
    .about-content :global(.location) {
        @apply text-sm text-gray-500;
    }
    
    /* Intro */
    .about-content :global(.about-intro) {
        @apply text-base leading-relaxed mb-8 text-gray-400;
    }
    
    /* Section Divider */
    .about-content :global(hr) {
        @apply border-gray-800 my-8;
    }
    
    /* Section Headings */
    .about-content :global(h2) {
        @apply text-lg font-semibold text-white mb-4 uppercase tracking-wider;
    }
    
    /* Expertise Grid */
    .about-content :global(.expertise-grid) {
        @apply mb-8;
    }
    
    .about-content :global(.expertise-card) {
        @apply bg-gray-900/50 border border-gray-800 rounded-lg p-5 hover:border-gray-700 transition-colors mb-8;
    }
    
    .about-content :global(.expertise-card:last-child) {
        @apply mb-0;
    }
    
    .about-content :global(.expertise-card h3) {
        @apply text-white font-medium mb-3 text-base;
    }
    
    .about-content :global(.expertise-card p) {
        @apply text-gray-400 text-sm mb-4 leading-relaxed;
    }
    
    .about-content :global(.tools) {
        @apply text-xs text-primary font-mono;
    }
    
    /* Tech Stack Grid */
    .about-content :global(.tech-grid) {
        @apply grid grid-cols-2 md:grid-cols-3 gap-3 mb-8;
    }
    
    .about-content :global(.tech-category) {
        @apply bg-gray-900/30 border border-gray-800 rounded-lg p-3;
    }
    
    .about-content :global(.tech-category h4) {
        @apply text-xs text-gray-500 uppercase tracking-wider mb-2 font-medium;
    }
    
    .about-content :global(.tech-item) {
        @apply inline-block text-xs text-gray-300 bg-gray-800 px-2 py-1 rounded mr-1 mb-1;
    }
    
    /* Working On List */
    .about-content :global(ul) {
        @apply space-y-2 mb-8 list-none;
    }
    
    .about-content :global(ul li) {
        @apply text-gray-400 text-sm pl-4 relative;
    }
    
    .about-content :global(ul li::before) {
        content: '→';
        @apply absolute left-0 text-primary;
    }
    
    /* Education Timeline */
    .about-content :global(.education-timeline) {
        @apply space-y-6;
    }
    
    .about-content :global(.education-item) {
        @apply flex gap-4;
    }
    
    .about-content :global(.edu-year) {
        @apply text-xs text-primary font-mono w-24 shrink-0 pt-1;
    }
    
    .about-content :global(.edu-content) {
        @apply flex-1;
    }
    
    .about-content :global(.edu-content h4) {
        @apply text-white font-medium mb-1;
    }
    
    .about-content :global(.edu-school) {
        @apply text-gray-400 text-sm mb-1;
    }
    
    .about-content :global(.edu-detail) {
        @apply text-gray-500 text-xs mb-1;
    }
    
    .about-content :global(.edu-subjects) {
        @apply text-gray-600 text-xs;
    }
    
    /* Links */
    .about-content :global(a) {
        @apply text-primary hover:underline;
    }
</style>
