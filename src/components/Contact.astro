<div>

    <!-- Start: Terminal -->
    <div class="terminal mt-6 bg-black rounded-lg border border-gray-600 font-mono text-sm overflow-hidden">
        <!-- Terminal Header -->
        <div class="terminal-header flex items-center gap-2 px-3 py-2 bg-gray-800 border-b border-gray-600">
            <div class="flex gap-1.5">
                <span class="w-3 h-3 rounded-full bg-red-500"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
                <span class="w-3 h-3 rounded-full bg-green-500"></span>
            </div>
            <span class="ml-2 text-xs text-gray-400">anik@portfolio ~ zsh</span>
        </div>
        
        <!-- Terminal Body -->
        <div class="terminal-body p-4 text-xs space-y-1 min-h-[120px]">
            <div class="terminal-line">
                <span class="text-primary">➜</span>
                <span class="text-gray-300 ml-2">npx connect</span>
            </div>
            
            <div class="terminal-line-1 hidden">
                <div class="flex items-center gap-2 mt-2">
                    <span class="text-gray-500">></span>
                    <span class="text-gray-400">Initializing connection...</span>
                </div>
            </div>
            
            <div class="terminal-line-2 hidden">
                <div class="flex items-center gap-2">
                    <span class="text-green-500">✓</span>
                    <span class="text-gray-300">Connection established</span>
                </div>
            </div>
            
            <div class="terminal-line-3 hidden">
                <div class="flex items-center gap-2">
                    <span class="text-green-500">✓</span>
                    <span class="text-gray-300">Ready to connect</span>
                </div>
            </div>
            
            <div class="terminal-line-4 hidden">
                <div class="flex items-center gap-2 mt-3">
                    <span class="text-primary">➜</span>
                    <span class="text-gray-300 ml-2">Waiting for contact request</span>
                    <span class="cursor">_</span>
                </div>
            </div>
        </div>
    </div>
    <!-- End: Terminal -->

    <!-- Start: Contact Info -->
