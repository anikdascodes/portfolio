                target="_blank" 
                rel="noopener noreferrer"
                class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-black border border-gray-700 text-gray-300 hover:text-white hover:border-primary hover:bg-gray-900 transition-all duration-200 group"
            >
                <svg class="w-4 h-4 text-gray-400 group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
