</div>

<style>
    .terminal {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
    }
    
    .cursor {
        display: inline-block;
        color: #10B981;
        font-weight: bold;
        animation: blink 1s step-end infinite;
    }
    
    @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }
    
    .hidden {
        display: none;
    }
    
    .fade-in {
        animation: fadeIn 0.3s ease-out forwards;
    }
    
    @keyframes fadeIn {
        from { 
            opacity: 0; 
            transform: translateY(-3px); 
        }
        to { 
            opacity: 1; 
            transform: translateY(0); 
        }
    }
</style>

<script>
    // Terminal typing animation sequence
    document.addEventListener('DOMContentLoaded', () => {
        const line1 = document.querySelector('.terminal-line-1');
        const line2 = document.querySelector('.terminal-line-2');
        const line3 = document.querySelector('.terminal-line-3');
        const line4 = document.querySelector('.terminal-line-4');
        
        // Show line 1 after 500ms
        setTimeout(() => {
            if (line1) {
                line1.classList.remove('hidden');
                line1.classList.add('fade-in');
            }
        }, 500);
        
        // Show line 2 after 1200ms
        setTimeout(() => {
            if (line2) {
                line2.classList.remove('hidden');
                line2.classList.add('fade-in');
            }
        }, 1200);
        
        // Show line 3 after 1900ms
        setTimeout(() => {
            if (line3) {
                line3.classList.remove('hidden');
                line3.classList.add('fade-in');
            }
        }, 1900);
        
        // Show line 4 after 2600ms
        setTimeout(() => {
            if (line4) {
                line4.classList.remove('hidden');
                line4.classList.add('fade-in');
            }
        }, 2600);
    });
</script>
