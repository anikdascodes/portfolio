---
// ContentResume.astro
---
<section class="resume-section my-8">
  <h2 class="text-2xl font-bold mb-4">Resume</h2>
  <div class="mb-4">
    <a href="https://drive.google.com/file/d/12etfBVZZL8mIlrd7imYIFHZGqQQpBypD/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="text-blue-400 underline">
      View/Download Resume (Google Drive)
    </a>
  </div>
  <div class="resume-preview border rounded-lg overflow-hidden shadow-lg">
    <iframe
      src="https://drive.google.com/file/d/12etfBVZZL8mIlrd7imYIFHZGqQQpBypD/preview"
      width="100%"
      height="600px"
      allow="autoplay"
      class="w-full border-none"
    ></iframe>
  </div>
</section>

<section class="certification-section my-8">
  <h2 class="text-2xl font-bold mb-4">Certifications</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="certificate-preview border rounded-lg p-4 shadow-lg">
      <h3 class="font-semibold mb-2">Data Analysis and Visualization with Python</h3>
      <iframe src="/certificates/Data Analysis and Visualization with Python.pdf" width="100%" height="300px" class="w-full border mb-2"></iframe>
      <a href="/certificates/Data Analysis and Visualization with Python.pdf" target="_blank" rel="noopener" class="text-blue-400 underline">View/Download PDF</a>
    </div>
    <div class="certificate-preview border rounded-lg p-4 shadow-lg">
      <h3 class="font-semibold mb-2">Introduction to Data Analytics</h3>
      <iframe src="/certificates/Introduction to Data Analytics.pdf" width="100%" height="300px" class="w-full border mb-2"></iframe>
      <a href="/certificates/Introduction to Data Analytics.pdf" target="_blank" rel="noopener" class="text-blue-400 underline">View/Download PDF</a>
    </div>
    <div class="certificate-preview border rounded-lg p-4 shadow-lg">
      <h3 class="font-semibold mb-2">Prompt Engineering for ChatGPT</h3>
      <iframe src="/certificates/Prompt Engineering for ChatGPT.pdf" width="100%" height="300px" class="w-full border mb-2"></iframe>
      <a href="/certificates/Prompt Engineering for ChatGPT.pdf" target="_blank" rel="noopener" class="text-blue-400 underline">View/Download PDF</a>
    </div>
    <div class="certificate-preview border rounded-lg p-4 shadow-lg">
      <h3 class="font-semibold mb-2">Python Programming Fundamentals</h3>
      <iframe src="/certificates/Python Programming Fundamentals.pdf" width="100%" height="300px" class="w-full border mb-2"></iframe>
      <a href="/certificates/Python Programming Fundamentals.pdf" target="_blank" rel="noopener" class="text-blue-400 underline">View/Download PDF</a>
    </div>
  </div>
</section>
