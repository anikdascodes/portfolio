---
// ContentResume.astro
---
<div class="flex flex-col h-full">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3 pb-3 border-b border-gray-700 shrink-0">
    <h2 class="text-xl font-bold">Resume</h2>
    
    <div class="flex gap-2">
      <a 
        href="/resume.pdf" 
        target="_blank" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary text-black rounded text-sm font-medium hover:bg-primary/80"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
        Open
      </a>
      <a 
        href="/resume.pdf" 
        download 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-gray-600 rounded text-sm hover:border-primary hover:text-primary"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        Download
      </a>
    </div>
  </div>

  <!-- PDF Viewer -->
  <div class="bg-gray-800 rounded-lg overflow-hidden border border-gray-700" style="height: 70vh;">
    <iframe
      src="/resume.pdf#toolbar=1&navpanes=0"
      class="w-full h-full block"
      title="Resume"
      type="application/pdf"
    ></iframe>
  </div>
</div>
