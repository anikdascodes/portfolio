---
import Icons from './Icons.astro';

interface Props {
  title: string;
  subtitle: string;
  period: string;
  location?: string;
  logoUrl?: string;
  description: string;
  bullets?: string[];
  isCurrent?: boolean;
}

const {
  title,
  subtitle,
  period,
  location,
  logoUrl,
  description,
  bullets = [],
} = Astro.props;
---

<div class="relative pl-6 pb-10 last:pb-0 group">
  <!-- Line -->
  <div class="absolute left-2 top-2 bottom-0 w-px bg-stone-300 dark:bg-stone-800 group-last:hidden"></div>

  <!-- Bullet Dot -->
  <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-[#fbf9f5] dark:bg-[#121110] border-2 border-stone-800 dark:border-stone-200 flex items-center justify-center">
    <div class="w-1.5 h-1.5 rounded-full bg-stone-800 dark:bg-stone-200"></div>
  </div>

  <div class="p-5 rounded-xl bg-white dark:bg-stone-900 border border-stone-200/90 dark:border-stone-800 shadow-xs space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-100 dark:border-stone-800 pb-3">
      <div class="flex items-center gap-3">
        {logoUrl && (
          <img
            src={logoUrl}
            alt={subtitle}
            class="w-10 h-10 rounded object-cover border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-950 p-0.5"
          />
        )}
        <div>
          <h3 class="text-base font-bold text-stone-900 dark:text-white font-serif">
            {title}
          </h3>
          <p class="text-xs font-semibold text-amber-800 dark:text-amber-400 font-mono">
            {subtitle}
          </p>
        </div>
      </div>

      <div class="text-xs text-stone-500 dark:text-stone-400 font-mono flex items-center gap-2">
        <span>{period}</span>
        {location && <span>• {location}</span>}
      </div>
    </div>

    <p class="text-stone-600 dark:text-stone-300 text-sm leading-relaxed">
      {description}
    </p>

    {bullets.length > 0 && (
      <ul class="space-y-1.5 pt-1 text-xs text-stone-600 dark:text-stone-400">
        {bullets.map((bullet) => (
          <li class="flex items-start gap-2">
            <span class="text-amber-800 dark:text-amber-400 font-bold">•</span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
