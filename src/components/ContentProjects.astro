---
interface Project {
    name: string;
    description: string;
    link: {
        url?: string;
        target?: string;
        title?: string;
        buttonLabel?: string;
    };
    tags?: string[];
};

const projects: Project[] = [{
    name: 'Resume Screening Application',
    description: 'A sophisticated resume screening application that leverages machine learning to analyze and process resumes efficiently. Built with advanced NLP techniques to extract and analyze key information from resumes, helping streamline the recruitment process.',
    link: {
        url: 'https://github.com/anikdascodes/resume-screening',
        buttonLabel: 'View on GitHub'
    },
    tags: ['python', 'machine-learning', 'nlp']
}];

const totalProjects = projects.length;
---

<div class="projects-container" data-project-search>
    <!-- Search Section -->
    <div class="search-section mb-6">
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
            <input
                type="text"
                id="project-search"
                placeholder="Search projects by name or description..."
                class="w-full pl-10 pr-4 py-3 bg-black border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
            />
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                <kbd class="hidden sm:inline-block px-2 py-1 text-xs font-mono text-gray-500 bg-gray-800 rounded border border-gray-700">Ctrl P</kbd>
            </div>
        </div>
        
        <!-- Active Search Display -->
        <div class="active-search hidden mt-3 flex items-center gap-2">
            <span class="text-sm text-gray-400">Search results for:</span>
            <span class="search-term px-3 py-1 text-sm bg-primary/20 text-primary rounded-full border border-primary/30"></span>
            <button class="clear-search text-sm text-gray-400 hover:text-white underline">Clear</button>
        </div>
    </div>

    <!-- Stats Header -->
    <div class="flex items-center justify-between gap-4 mb-6 text-sm text-gray-400 border-b border-gray-700 pb-4">
        <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <span id="projects-count">{totalProjects}</span> <span id="projects-label">{totalProjects === 1 ? 'project' : 'projects'}</span>
        </span>
    </div>

    <!-- No Results Message -->
    <div class="no-results hidden border border-gray-700 rounded-lg p-8 bg-black text-center">
        <svg class="w-12 h-12 mx-auto mb-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <p class="text-gray-400 mb-2">No projects found matching your search.</p>
        <p class="text-gray-500 text-sm">Try different keywords or clear the search.</p>
    </div>

    <!-- Projects List -->
    <div id="projects-list" class="grid grid-cols-1 md:grid-cols-1 gap-4">
        {projects.map((project) => (
            <div class="project-item flex flex-col justify-center items-start border border-gray-700 rounded-lg p-4 bg-black hover:border-gray-500 transition-colors" data-name={project.name.toLowerCase()} data-description={project.description.toLowerCase()} data-tags={project.tags?.join(' ').toLowerCase() || ''}>
                <h3 class="project-name text-xl font-semibold text-white mb-2">
                    {project.name}
                </h3>

                <p class="project-description text-gray-400">
                    {project.description}
                </p>
                
                {project.tags && project.tags.length > 0 && (
                    <div class="project-tags flex flex-wrap gap-2 mt-3">
                        {project.tags.map((tag: string) => (
                            <span class="px-2 py-0.5 bg-gray-800 rounded text-xs text-gray-300 border border-gray-700">{tag}</span>
                        ))}
                    </div>
                )}

                {project.link?.url && (
                    <a
                        href={project.link.url}
                        title={project.link.title || project.name}
                        target={project.link.target || '_blank'}
                        class="w-full px-4 py-2.5 mt-4 text-center border border-gray-600 rounded-lg hover:text-primary hover:border-primary transition-colors"
                    >
                        {project.link.buttonLabel || 'Open Project Website'}
                    </a>
                )}
            </div>
        ))}
    </div>
</div>

<script define:vars={{ totalProjects }}>
    const root = document.querySelector('[data-project-search]') as HTMLElement;

    // DOM Elements
    const searchInput = root.querySelector('#project-search');
    const projectsList = root.querySelector('#projects-list');
    const noResults = root.querySelector('.no-results');
    const activeSearch = root.querySelector('.active-search');
    const searchTermDisplay = root.querySelector('.search-term');
    const clearSearchBtn = root.querySelector('.clear-search');
    const projectsCount = root.querySelector('#projects-count');
    const projectsLabel = root.querySelector('#projects-label');
    
    let currentSearch = '';
    
    // Search function
    function performSearch() {
        const query = currentSearch.toLowerCase().trim();
        
        // Get all project items
        const projectItems = projectsList.querySelectorAll('.project-item');
        let visibleCount = 0;
        
        projectItems.forEach(item => {
            const name = item.getAttribute('data-name') || '';
            const description = item.getAttribute('data-description') || '';
            const tags = item.getAttribute('data-tags') || '';
            
            // Search in name, description, and tags
            const searchText = `${name} ${description} ${tags}`;
            const matchesSearch = !query || searchText.includes(query);
            
            if (matchesSearch) {
                item.classList.remove('hidden');
                visibleCount++;
                
                // Highlight matching text if searching
                if (query) {
                    highlightText(item, query);
                } else {
                    resetHighlight(item);
                }
            } else {
                item.classList.add('hidden');
            }
        });
        
        // Update UI
        updateUI(visibleCount);
    }
    
    // Highlight matching text
    function highlightText(item, query) {
        const nameEl = item.querySelector('.project-name');
        const descEl = item.querySelector('.project-description');
        
        if (nameEl) {
            const originalText = nameEl.getAttribute('data-original') || nameEl.textContent || '';
            if (!nameEl.getAttribute('data-original')) {
                nameEl.setAttribute('data-original', originalText);
            }
            nameEl.innerHTML = highlightMatch(originalText, query);
        }
        
        if (descEl) {
            const originalText = descEl.getAttribute('data-original') || descEl.textContent || '';
            if (!descEl.getAttribute('data-original')) {
                descEl.setAttribute('data-original', originalText);
            }
            descEl.innerHTML = highlightMatch(originalText, query);
        }
    }
    
    // Reset highlight
    function resetHighlight(item) {
        const nameEl = item.querySelector('.project-name');
        const descEl = item.querySelector('.project-description');
        
        if (nameEl) {
            const originalText = nameEl.getAttribute('data-original');
            if (originalText) {
                nameEl.textContent = originalText;
            }
        }
        if (descEl) {
            const originalText = descEl.getAttribute('data-original');
            if (originalText) {
                descEl.textContent = originalText;
            }
        }
    }
    
    // Highlight matching text with mark
    function highlightMatch(text, query) {
        const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
        return text.replace(regex, '<mark class="bg-primary/30 text-primary px-0.5 rounded">$1</mark>');
    }
    
    // Escape special regex characters
    function escapeRegex(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }
    
    // Update UI based on search results
    function updateUI(visibleCount) {
        // Update count
        projectsCount.textContent = visibleCount;
        projectsLabel.textContent = visibleCount === 1 ? 'project' : 'projects';
        
        // Show/hide no results
        if (visibleCount === 0) {
            noResults.classList.remove('hidden');
        } else {
            noResults.classList.add('hidden');
        }
        
        // Show/hide active search
        if (currentSearch) {
            activeSearch.classList.remove('hidden');
            searchTermDisplay.textContent = currentSearch;
        } else {
            activeSearch.classList.add('hidden');
        }
    }
    
    // Clear search
    function clearSearch() {
        currentSearch = '';
        searchInput.value = '';
        performSearch();
        
        // Reset all highlights
        const projectItems = projectsList.querySelectorAll('.project-item');
        projectItems.forEach(item => resetHighlight(item));
    }
    
    // Event Listeners
    searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value;
        performSearch();
    });
    
    // Keyboard shortcut (Ctrl/Cmd + P)
    document.addEventListener('keydown', (e) => {
        // Only trigger if not in an input field (except for the search input itself)
        const activeElement = document.activeElement;
        const isTyping = activeElement && (activeElement.tagName === 'INPUT' || activeElement.tagName === 'TEXTAREA');
        
        if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
            e.preventDefault();
            searchInput.focus();
        }
        
        // Escape to clear search
        if (e.key === 'Escape' && currentSearch) {
            clearSearch();
        }
    });
    
    // Clear search button
    clearSearchBtn.addEventListener('click', clearSearch);
</script>

<style>
    /* Highlight mark styling */
    mark {
        background-color: rgba(16, 185, 129, 0.3);
        color: #10B981;
        padding: 0 2px;
        border-radius: 2px;
    }
    
    /* Search input focus animation */
    #project-search:focus {
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    }
    
    /* Smooth transitions for show/hide */
    .project-item {
        transition: all 0.2s ease-in-out;
    }
    
    .project-item.hidden {
        display: none;
    }
</style>
