---
import Icons from './Icons.astro';

interface Props {
  title: string;
  summary: string;
  imageUrl: string;
  demoUrl: string;
  githubUrl: string;
  techStack: string[];
  impactMetric?: string;
  featured?: boolean;
}

const {
  title,
  summary,
  imageUrl,
  demoUrl,
  githubUrl,
  techStack = [],
} = Astro.props;
---

<div class="group rounded-lg bg-[var(--paper-card)] p-4 hover:shadow-md transition-all duration-200 flex flex-col justify-between space-y-3">
  <!-- Image -->
  <div class="aspect-[16/10] w-full overflow-hidden rounded-md bg-[var(--border-paper)]">
    <img
      src={imageUrl}
      alt={title}
      class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-300"
      loading="lazy"
    />
  </div>

  <div class="space-y-2 flex-1">
    <h3 class="font-serif text-lg text-[var(--ink-primary)] group-hover:text-[var(--accent)] transition-colors">
      {title}
    </h3>
    <p class="text-[var(--ink-secondary)] text-sm leading-relaxed line-clamp-2">
      {summary}
    </p>
  </div>

  <div class="space-y-3 pt-2 border-t border-[var(--border-paper)]">
    <!-- Tech Stack -->
    <div class="flex flex-wrap gap-1.5">
      {techStack.map((tech) => (
        <span class="px-2 py-0.5 rounded text-[var(--ink-secondary)] text-xs font-mono bg-[var(--accent-subtle)]">
          {tech}
        </span>
      ))}
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between">
      <a
        href={demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[var(--accent)] hover:underline underline-offset-4 inline-flex items-center gap-1"
      >
        View project
        <Icons name="ArrowUpRight" class="w-3.5 h-3.5" />
      </a>

      {githubUrl && githubUrl !== '#' && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--ink-secondary)] hover:text-[var(--ink-primary)] transition-colors p-1"
          aria-label="Source code"
        >
          <Icons name="Github" class="w-4 h-4" />
        </a>
      )}
    </div>
  </div>
</div>
