---
// ContentCertifications.astro
---
<section class="certifications-section my-8">
  <h2 class="text-2xl font-bold mb-4">Certifications</h2>
  <div class="space-y-6">
    <!-- Prompt Engineering for ChatGPT -->
    <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
      <embed src="/certificate/Prompt Engineering for ChatGPT.pdf" type="application/pdf" class="w-32 h-24 object-contain border border-gray-700 rounded bg-white" />
      <div>
        <h3 class="text-lg font-semibold text-white">Prompt Engineering for ChatGPT</h3>
        <p class="text-gray-400">Vanderbilt University &bull; Coursera</p>
        <a href="https://www.coursera.org/account/accomplishments/verify/LHFXB266LE29" target="_blank" class="text-blue-400 underline">Verify on Coursera</a>
        <a href="/certificate/Prompt Engineering for ChatGPT.pdf" target="_blank" class="ml-4 text-green-400 underline">View PDF</a>
      </div>
    </div>
    <!-- Introduction to Data Analytics -->
    <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
      <embed src="/certificate/Introduction to Data Analytics.pdf" type="application/pdf" class="w-32 h-24 object-contain border border-gray-700 rounded bg-white" />
      <div>
        <h3 class="text-lg font-semibold text-white">Introduction to Data Analytics</h3>
        <p class="text-gray-400">Meta &bull; Coursera</p>
        <a href="https://www.coursera.org/account/accomplishments/verify/4BWBS67J5FZW" target="_blank" class="text-blue-400 underline">Verify on Coursera</a>
        <a href="/certificate/Introduction to Data Analytics.pdf" target="_blank" class="ml-4 text-green-400 underline">View PDF</a>
      </div>
    </div>
    <!-- Python Programming Fundamentals -->
    <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
      <embed src="/certificate/Python Programming Fundamentals.pdf" type="application/pdf" class="w-32 h-24 object-contain border border-gray-700 rounded bg-white" />
      <div>
        <h3 class="text-lg font-semibold text-white">Python Programming Fundamentals</h3>
        <p class="text-gray-400">Microsoft &bull; Coursera</p>
        <a href="https://www.coursera.org/account/accomplishments/verify/14NUFGSP66LP" target="_blank" class="text-blue-400 underline">Verify on Coursera</a>
        <a href="/certificate/Python Programming Fundamentals.pdf" target="_blank" class="ml-4 text-green-400 underline">View PDF</a>
      </div>
    </div>
    <!-- Data Analysis and Visualization with Python -->
    <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
      <embed src="/certificate/Data Analysis and Visualization with Python.pdf" type="application/pdf" class="w-32 h-24 object-contain border border-gray-700 rounded bg-white" />
      <div>
        <h3 class="text-lg font-semibold text-white">Data Analysis and Visualization with Python</h3>
        <p class="text-gray-400">Microsoft &bull; Coursera</p>
        <a href="https://www.coursera.org/account/accomplishments/verify/PVOY0YGZPDUD" target="_blank" class="text-blue-400 underline">Verify on Coursera</a>
        <a href="/certificate/Data Analysis and Visualization with Python.pdf" target="_blank" class="ml-4 text-green-400 underline">View PDF</a>
      </div>
    </div>
  </div>
</section>
