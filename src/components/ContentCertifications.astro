---
// ContentCertifications.astro - Now Education & Certifications
---
<section class="education-section my-8">
  <h2 class="text-2xl font-bold mb-6">Education</h2>
  <div class="education-timeline space-y-6">
    
    <!-- MSc Data Science and AI -->
    <div class="education-item border-l-4 border-primary pl-4 py-2">
      <div class="text-sm text-primary font-semibold mb-1">2025 – Present</div>
      <h3 class="text-lg font-bold text-white">MSc in Data Science and AI</h3>
      <p class="text-gray-300">BITS Pilani (Digital)</p>
      <p class="text-gray-400 text-sm">Postgraduate Program</p>
    </div>
    
    <!-- BSc Data Science -->
    <div class="education-item border-l-4 border-primary pl-4 py-2">
      <div class="text-sm text-primary font-semibold mb-1">2022 – 2025</div>
      <h3 class="text-lg font-bold text-white">BSc in Data Science</h3>
      <p class="text-gray-300">Calcutta Institute of Science And Management</p>
      <p class="text-gray-400 text-sm">Affiliated to MAKAUT, West Bengal • Completed July 2025</p>
    </div>
    
    <!-- Higher Secondary -->
    <div class="education-item border-l-4 border-primary pl-4 py-2">
      <div class="text-sm text-primary font-semibold mb-1">2022</div>
      <h3 class="text-lg font-bold text-white">Higher Secondary (Science)</h3>
      <p class="text-gray-300">Gournagar High School</p>
      <p class="text-gray-400 text-sm">West Bengal Council of Higher Secondary Education</p>
      <p class="text-gray-500 text-xs mt-1">Physics • Chemistry • Mathematics • Computer Science</p>
    </div>
    
  </div>
</section>

<section class="certifications-section my-8 mt-12 pt-8 border-t border-gray-700">
  <h2 class="text-2xl font-bold mb-4">Certifications</h2>
  <div class="space-y-6">
    <!-- Prompt Engineering for ChatGPT -->
    <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
      <embed data-lazy-src="/certificates/Prompt Engineering for ChatGPT.pdf" type="application/pdf" class="w-32 h-24 object-contain border border-gray-700 rounded bg-white" title="Preview of Prompt Engineering for ChatGPT Certificate" />
      <div>
        <h3 class="text-lg font-semibold text-white">Prompt Engineering for ChatGPT</h3>
        <p class="text-gray-400">Vanderbilt University &bull; Coursera</p>
        <a href="https://www.coursera.org/account/accomplishments/verify/LHFXB266LE29" target="_blank" class="text-blue-400 underline">Verify on Coursera</a>
        <a href="/certificates/Prompt Engineering for ChatGPT.pdf" target="_blank" class="ml-4 text-green-400 underline">View PDF</a>
      </div>
    </div>
    <!-- Introduction to Data Analytics -->
    <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
      <embed data-lazy-src="/certificates/Introduction to Data Analytics.pdf" type="application/pdf" class="w-32 h-24 object-contain border border-gray-700 rounded bg-white" title="Preview of Introduction to Data Analytics Certificate" />
      <div>
        <h3 class="text-lg font-semibold text-white">Introduction to Data Analytics</h3>
        <p class="text-gray-400">Meta &bull; Coursera</p>
        <a href="https://www.coursera.org/account/accomplishments/verify/4BWBS67J5FZW" target="_blank" class="text-blue-400 underline">Verify on Coursera</a>
        <a href="/certificates/Introduction to Data Analytics.pdf" target="_blank" class="ml-4 text-green-400 underline">View PDF</a>
      </div>
    </div>
    <!-- Python Programming Fundamentals -->
    <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
      <embed data-lazy-src="/certificates/Python Programming Fundamentals.pdf" type="application/pdf" class="w-32 h-24 object-contain border border-gray-700 rounded bg-white" title="Preview of Python Programming Fundamentals Certificate" />
      <div>
        <h3 class="text-lg font-semibold text-white">Python Programming Fundamentals</h3>
        <p class="text-gray-400">Microsoft &bull; Coursera</p>
        <a href="https://www.coursera.org/account/accomplishments/verify/14NUFGSP66LP" target="_blank" class="text-blue-400 underline">Verify on Coursera</a>
        <a href="/certificates/Python Programming Fundamentals.pdf" target="_blank" class="ml-4 text-green-400 underline">View PDF</a>
      </div>
    </div>
    <!-- Data Analysis and Visualization with Python -->
    <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
      <embed data-lazy-src="/certificates/Data Analysis and Visualization with Python.pdf" type="application/pdf" class="w-32 h-24 object-contain border border-gray-700 rounded bg-white" title="Preview of Data Analysis and Visualization with Python Certificate" />
      <div>
        <h3 class="text-lg font-semibold text-white">Data Analysis and Visualization with Python</h3>
        <p class="text-gray-400">Microsoft &bull; Coursera</p>
        <a href="https://www.coursera.org/account/accomplishments/verify/PVOY0YGZPDUD" target="_blank" class="text-blue-400 underline">Verify on Coursera</a>
        <a href="/certificates/Data Analysis and Visualization with Python.pdf" target="_blank" class="ml-4 text-green-400 underline">View PDF</a>
      </div>
    </div>
  </div>
  
  <div class="mt-12">
    <h3 class="text-xl font-semibold mb-4">Courses from deeplearning.ai</h3>
    <div class="space-y-6">
      <!-- AI Python for Beginners -->
      <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
        <div class="w-32 h-24 flex items-center justify-center border border-gray-700 rounded bg-white text-gray-700 font-bold text-sm">deeplearning.ai</div>
        <div>
          <h3 class="text-lg font-semibold text-white">AI Python for Beginners</h3>
          <p class="text-gray-400">deeplearning.ai</p>
          <a href="https://learn.deeplearning.ai/accomplishments/0f3441fb-5650-4a9e-bc79-914baada0387?usp=sharing" target="_blank" class="text-blue-400 underline">Verify Course Completion</a>
        </div>
      </div>
      <!-- Collaborative Writing and Coding with OpenAI Canvas -->
      <div class="border rounded-lg p-4 bg-black shadow-lg flex flex-col md:flex-row md:items-center gap-4">
        <div class="w-32 h-24 flex items-center justify-center border border-gray-700 rounded bg-white text-gray-700 font-bold text-sm">deeplearning.ai</div>
        <div>
          <h3 class="text-lg font-semibold text-white">Collaborative Writing and Coding with OpenAI Canvas</h3>
          <p class="text-gray-400">deeplearning.ai</p>
          <a href="https://learn.deeplearning.ai/accomplishments/3bbb1950-1167-40c7-b93d-2d66a31a5086?usp=sharing" target="_blank" class="text-blue-400 underline">Verify Course Completion</a>
        </div>
      </div>
    </div>
  </div>
</section>
