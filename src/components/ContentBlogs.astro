---
import { getCollection } from 'astro:content';

const blogs = await getCollection('blogs');
const isProd = import.meta.env.PROD;
const publishedBlogs = isProd ? blogs.filter(blog => !blog.data.draft) : blogs;
const sortedBlogs = publishedBlogs.sort((a, b) => 
    b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

function formatDate(date: Date) {
    return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}

function getReadingTime(content: string): number {
    const wordsPerMinute = 200;
    const words = content.trim().split(/\s+/).length;
    return Math.ceil(words / wordsPerMinute);
}

function getExcerpt(blog: any): string {
    if (blog.data.description) return blog.data.description;
    return blog.body.slice(0, 150).replace(/[#*`|]/g, '') + '...';
}

function getSlug(blog: any): string {
    return blog.slug || blog.id.replace(/\/index$/, '');
}

// Prepare search index for client-side search
const searchIndex = sortedBlogs.map(blog => ({
    slug: getSlug(blog),
    title: blog.data.title,
    description: blog.data.description || '',
    tags: blog.data.tags || [],
    author: blog.data.author,
    publishDate: blog.data.publishDate.toISOString(),
    readingTime: getReadingTime(blog.body),
    excerpt: getExcerpt(blog)
}));

const totalPosts = sortedBlogs.length;
const totalWords = sortedBlogs.reduce((acc, blog) => acc + blog.body.split(/\s+/).length, 0);
---

<div class="blog-container" data-blog-search>
    <!-- Search Section -->
    <div class="search-section mb-6">
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
            <input
                type="text"
                id="blog-search"
                placeholder="Search blogs by title, description, or tags..."
                class="w-full pl-10 pr-4 py-3 bg-black border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
            />
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                <kbd class="hidden sm:inline-block px-2 py-1 text-xs font-mono text-gray-500 bg-gray-800 rounded border border-gray-700">Ctrl K</kbd>
            </div>
        </div>
        
        <!-- Active Search Display -->
        <div class="active-search hidden mt-3 flex items-center gap-2">
            <span class="text-sm text-gray-400">Search results for:</span>
            <span class="search-term px-3 py-1 text-sm bg-primary/20 text-primary rounded-full border border-primary/30"></span>
            <button class="clear-search text-sm text-gray-400 hover:text-white underline">Clear</button>
        </div>
    </div>

    <!-- Stats Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6 text-sm text-gray-400 border-b border-gray-700 pb-4">
        <div class="flex gap-4">
            <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                <span id="posts-count">{totalPosts}</span> <span id="posts-label">{totalPosts === 1 ? 'post' : 'posts'}</span>
            </span>
            <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                {Math.round(totalWords / 1000)}k+ words
            </span>
        </div>
        <a href="/rss.xml" target="_blank" class="flex items-center gap-1 text-primary hover:underline">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.755-23.954-24-24v4.812z"/>
            </svg>
            RSS Feed
        </a>
    </div>

    <!-- No Results Message -->
    <div class="no-results hidden border border-gray-700 rounded-lg p-8 bg-black text-center">
        <svg class="w-12 h-12 mx-auto mb-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <p class="text-gray-400 mb-2">No blogs found matching your search.</p>
        <p class="text-gray-500 text-sm">Try different keywords or clear the search.</p>
    </div>

    <!-- Blog List -->
    <div id="blog-list" class="space-y-6">
        {sortedBlogs.map((blog) => (
            <article class="blog-item border border-gray-700 rounded-lg p-5 bg-black hover:border-gray-500 transition-colors group" data-slug={getSlug(blog)}>
                <div class="flex flex-col gap-3">
                    <h2 class="blog-title text-xl font-bold text-white group-hover:text-primary transition-colors">
                        <a href={`/blog/${getSlug(blog)}/`} target="_blank" rel="noopener noreferrer">
                            <span class="blog-title-text">{blog.data.title}</span>
                            {blog.data.draft && (
                                <span class="draft-badge ml-2 text-xs bg-yellow-900 text-yellow-200 px-2 py-0.5 rounded">DRAFT</span>
                            )}
                        </a>
                    </h2>
                    
                    <div class="flex flex-wrap items-center gap-4 text-xs text-gray-400">
                        <time datetime={blog.data.publishDate.toISOString()} class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            {formatDate(blog.data.publishDate)}
                        </time>
                        
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            {getReadingTime(blog.body)} min read
                        </span>
                        
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            {blog.data.author}
                        </span>
                    </div>
                    
                    <p class="blog-description text-gray-400 text-sm line-clamp-2">{getExcerpt(blog)}</p>
                    
                    {blog.data.tags && blog.data.tags.length > 0 && (
                        <div class="blog-tags flex flex-wrap gap-2">
                            {blog.data.tags.map((tag: string) => (
                                <span class="px-2 py-0.5 bg-gray-800 rounded text-xs text-gray-300 border border-gray-700">#{tag}</span>
                            ))}
                        </div>
                    )}
                    
                    <a href={`/blog/${getSlug(blog)}/`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm text-primary hover:underline mt-1">
                        Read Article
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                        </svg>
                    </a>
                </div>
            </article>
        ))}
    </div>
</div>

<script define:vars={{ searchIndex: JSON.stringify(searchIndex), totalPosts }}>
    // Parse the search index
    const blogs = JSON.parse(searchIndex);
    const root = document.querySelector('[data-blog-search]') as HTMLElement;
    
    // DOM Elements
    const searchInput = root.querySelector('#blog-search');
    const blogList = root.querySelector('#blog-list');
    const noResults = root.querySelector('.no-results');
    const activeSearch = root.querySelector('.active-search');
    const searchTermDisplay = root.querySelector('.search-term');
    const clearSearchBtn = root.querySelector('.clear-search');
    const postsCount = root.querySelector('#posts-count');
    const postsLabel = root.querySelector('#posts-label');
    
    let currentSearch = '';
    
    // Search function
    function performSearch() {
        const query = currentSearch.toLowerCase().trim();
        
        // Get all blog items
        const blogItems = blogList.querySelectorAll('.blog-item');
        let visibleCount = 0;
        
        blogItems.forEach(item => {
            const slug = item.getAttribute('data-slug');
            const blog = blogs.find(b => b.slug === slug);
            
            if (!blog) return;
            
            // Search in title, description, excerpt, and tags
            const searchText = `${blog.title} ${blog.description} ${blog.excerpt} ${blog.tags.join(' ')}`.toLowerCase();
            const matchesSearch = !query || searchText.includes(query);
            
            if (matchesSearch) {
                item.classList.remove('hidden');
                visibleCount++;
                
                // Highlight matching text if searching
                if (query) {
                    highlightText(item, blog, query);
                } else {
                    resetHighlight(item, blog);
                }
            } else {
                item.classList.add('hidden');
            }
        });
        
        // Update UI
        updateUI(visibleCount);
    }
    
    // Highlight matching text
    function highlightText(item, blog, query) {
        const titleEl = item.querySelector('.blog-title-text');
        const descEl = item.querySelector('.blog-description');
        
        if (titleEl && blog.title.toLowerCase().includes(query)) {
            titleEl.innerHTML = highlightMatch(blog.title, query);
        }
        
        if (descEl && blog.excerpt.toLowerCase().includes(query)) {
            const shortExcerpt = blog.excerpt.slice(0, 200);
            descEl.innerHTML = highlightMatch(shortExcerpt, query);
        }
    }
    
    // Reset highlight
    function resetHighlight(item, blog) {
        const titleEl = item.querySelector('.blog-title-text');
        const descEl = item.querySelector('.blog-description');
        
        if (titleEl) {
            titleEl.textContent = blog.title;
        }
        if (descEl) {
            descEl.textContent = blog.excerpt;
        }
    }
    
    // Highlight matching text with mark
    function highlightMatch(text, query) {
        const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
        return text.replace(regex, '<mark class="bg-primary/30 text-primary px-0.5 rounded">$1</mark>');
    }
    
    // Escape special regex characters
    function escapeRegex(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }
    
    // Update UI based on search results
    function updateUI(visibleCount) {
        // Update count
        postsCount.textContent = visibleCount;
        postsLabel.textContent = visibleCount === 1 ? 'post' : 'posts';
        
        // Show/hide no results
        if (visibleCount === 0) {
            noResults.classList.remove('hidden');
        } else {
            noResults.classList.add('hidden');
        }
        
        // Show/hide active search
        if (currentSearch) {
            activeSearch.classList.remove('hidden');
            searchTermDisplay.textContent = currentSearch;
        } else {
            activeSearch.classList.add('hidden');
        }
    }
    
    // Clear search
    function clearSearch() {
        currentSearch = '';
        searchInput.value = '';
        performSearch();
        
        // Reset all highlights
        const blogItems = blogList.querySelectorAll('.blog-item');
        blogItems.forEach(item => {
            const slug = item.getAttribute('data-slug');
            const blog = blogs.find(b => b.slug === slug);
            if (blog) resetHighlight(item, blog);
        });
    }
    
    // Event Listeners
    searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value;
        performSearch();
    });
    
    // Keyboard shortcut (Ctrl/Cmd + K)
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            searchInput.focus();
        }
        
        // Escape to clear search
        if (e.key === 'Escape' && currentSearch) {
            clearSearch();
        }
    });
    
    // Clear search button
    clearSearchBtn.addEventListener('click', clearSearch);
</script>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    /* Highlight mark styling */
    mark {
        background-color: rgba(16, 185, 129, 0.3);
        color: #10B981;
        padding: 0 2px;
        border-radius: 2px;
    }
    
    /* Search input focus animation */
    #blog-search:focus {
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    }
    
    /* Smooth transitions for show/hide */
    .blog-item {
        transition: all 0.2s ease-in-out;
    }
    
    .blog-item.hidden {
        display: none;
    }
</style>
