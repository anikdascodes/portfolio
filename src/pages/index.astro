---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icons from '../components/Icons.astro';

import siteSettings from '../content/site-settings/index.json';
import hero from '../content/hero/index.json';
import about from '../content/about/index.json';
import homeSections from '../content/home-sections/index.json';

import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .map(p => p.data)
  .filter(p => p.featured)
  .sort((a, b) => a.order - b.order)
  .slice(0, 3);
---

<Layout title={`${siteSettings.siteName} — Portfolio`}>
  <div class="space-y-20">
    <!-- HERO -->
    <section class="flex flex-col md:flex-row items-start justify-between gap-10 pt-4">
      <!-- Text -->
      <div class="flex-1 space-y-6 order-2 md:order-1">
        <h1 class="font-serif italic text-5xl sm:text-6xl lg:text-7xl text-[var(--ink-primary)] leading-[1.05] tracking-tight">
          {hero.headline || siteSettings.siteName}
        </h1>

        <p class="text-[var(--ink-secondary)] text-lg leading-relaxed max-w-lg">
          {about.bioText || hero.subheadline}
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href={hero.ctaPrimaryLink}
            class="px-5 py-2.5 rounded-md bg-[var(--ink-primary)] text-[var(--bg-paper)] text-sm font-medium hover:opacity-90 transition-opacity inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-paper)]"
          >
            {hero.ctaPrimaryText}
            <Icons name="ArrowRight" class="w-3.5 h-3.5" />
          </a>

          <a
            href={hero.resumeUrl || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-md border border-[var(--border-paper)] text-[var(--ink-primary)] text-sm font-medium hover:border-[var(--ink-secondary)] transition-colors inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-paper)]"
          >
            {hero.resumeText || 'Resume ↗'}
          </a>

          <a
            href={hero.ctaSecondaryLink}
            class="px-4 py-2.5 text-[var(--accent)] text-sm font-medium hover:underline underline-offset-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-paper)] rounded-md"
          >
            {hero.ctaSecondaryText}
          </a>
        </div>
      </div>

      <!-- Photo -->
      <div class="order-1 md:order-2 shrink-0">
        <div class="relative w-44 h-44 sm:w-52 sm:h-52">
          <div class="w-full h-full rounded-full overflow-hidden border-2 border-[var(--border-paper)] shadow-lg shadow-black/5 dark:shadow-black/20">
            <img
              src={siteSettings.avatarUrl}
              alt={siteSettings.siteName}
              fetchpriority="high"
              width="208"
              height="208"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>
          <!-- Subtle paper-edge shadow underneath -->
          <div class="absolute -inset-1 rounded-full bg-[var(--ink-primary)]/5 dark:bg-white/5 -z-10 blur-md"></div>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="space-y-8">
      <div class="flex items-baseline justify-between gap-4 border-b border-[var(--border-paper)] pb-4">
        <h2 class="font-serif italic text-2xl text-[var(--ink-primary)]">
          {homeSections.featuredProjectsHeading || 'Projects'}
        </h2>
        <a
          href={homeSections.featuredProjectsViewAllLink || '/projects'}
          class="text-sm text-[var(--accent)] hover:underline underline-offset-4"
        >
          {homeSections.featuredProjectsViewAllText || 'See all'} →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {featuredProjects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>
  </div>
</Layout>
