---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

function getSlug(post: any): string {
    return post.slug || post.id.replace(/\/index$/, '');
}

export async function getStaticPaths() {
    try {
        const posts = await getCollection('blogs');
        const getPostSlug = (post: any) => post.slug || post.id.replace(/\/index$/, '');
        // Filter out drafts in production
        const publishedPosts = import.meta.env.PROD 
            ? posts.filter(post => !post.data.draft)
            : posts;
            
        return publishedPosts.map(post => {
            return {
                params: { slug: getPostSlug(post) },
                props: { post },
            };
        });
    } catch (error) {
        console.error("Error generating blog routes:", error);
        return [];
    }
}

const { post } = Astro.props;
const postSlug = getSlug(post);

// Handle case where post doesn't exist
if (!post) {
    return Astro.redirect('/');
}

const { Content } = await render(post);

// Extract data for SEO
const { 
    title, 
    description, 
    publishDate, 
    tags, 
    author, 
    featuredImage,
    canonicalURL 
} = post.data;

// Blog assets are copied to /blog/<slug>/ after the Astro build.
const featuredImageUrl = featuredImage ? featuredImage.src : undefined;

function formatDate(date: Date) {
    return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}

// Estimate reading time
function getReadingTime(content: string): number {
    const wordsPerMinute = 200;
    const words = content.trim().split(/\s+/).length;
    return Math.ceil(words / wordsPerMinute);
}

const readingTime = getReadingTime(post.body);
---

<Layout 
    title={title}
    description={description}
    ogType="article"
    ogImage={featuredImageUrl}
    canonicalURL={canonicalURL}
    publishDate={publishDate}
    author={author}
    tags={tags}
>
    <main class="max-w-4xl mx-auto px-4 py-8 w-full">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="mb-6">
            <ol class="flex items-center space-x-2 text-sm text-gray-400">
                <li>
                    <a href="/" class="hover:text-primary transition-colors">Home</a>
                </li>
                <li>/</li>
                <li>
                    <a href="/#tab3" class="hover:text-primary transition-colors">Blog</a>
                </li>
                <li>/</li>
                <li class="text-gray-300 truncate max-w-xs" aria-current="page">{title}</li>
            </ol>
        </nav>

        <article class="prose prose-invert max-w-none">
            <!-- Article Header -->
            <header class="mb-8 border-b border-gray-700 pb-8">
                <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 leading-tight">
                    {title}
                </h1>
                
                {description && (
                    <p class="text-xl text-gray-300 mb-6 italic">
                        {description}
                    </p>
                )}
                
                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400">
                    <!-- Author -->
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span>{author}</span>
                    </div>
                    
                    <!-- Publish Date -->
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <time datetime={publishDate.toISOString()}>
                            {formatDate(publishDate)}
                        </time>
                    </div>
                    
                    <!-- Reading Time -->
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>{readingTime} min read</span>
                    </div>
                </div>
                
                <!-- Tags -->
                {tags && tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-4">
                        {tags.map(tag => (
                            <span class="px-3 py-1 bg-gray-800 rounded-full text-xs text-primary border border-gray-700">
                                #{tag}
                            </span>
                        ))}
                    </div>
                )}
            </header>

            <!-- Featured Image -->
            {featuredImage && (
                <figure class="mb-8">
                    <img 
                        src={featuredImageUrl}
                        alt={`Featured image for ${title}`}
                        class="w-full h-auto rounded-lg border border-gray-700"
                        loading="eager"
                    />
                </figure>
            )}

            <!-- Article Content -->
            <div class="prose-content">
                <Content />
            </div>

            <script>
    // Add copy buttons to code blocks
    document.addEventListener('DOMContentLoaded', () => {
        const codeBlocks = document.querySelectorAll('pre code');
        codeBlocks.forEach((codeBlock) => {
            const pre = codeBlock.parentElement;
            if (!pre) return;
            
            // Create copy button
            const button = document.createElement('button');
            button.className = 'copy-code-btn absolute top-2 right-2 px-2 py-1 text-xs bg-gray-700 hover:bg-gray-600 text-gray-300 rounded border border-gray-600 transition-colors opacity-0 group-hover:opacity-100';
            button.textContent = 'Copy';
            
            // Make pre relative for positioning
            pre.classList.add('relative', 'group');
            pre.appendChild(button);
            
            // Copy functionality
            button.addEventListener('click', async () => {
                const code = codeBlock.textContent || '';
                try {
                    await navigator.clipboard.writeText(code);
                    button.textContent = 'Copied!';
                    button.classList.add('bg-primary', 'text-black', 'border-primary');
                    setTimeout(() => {
                        button.textContent = 'Copy';
                        button.classList.remove('bg-primary', 'text-black', 'border-primary');
                    }, 2000);
                } catch (err) {
                    button.textContent = 'Failed';
                    setTimeout(() => {
                        button.textContent = 'Copy';
                    }, 2000);
                }
            });
        });
    });
</script>

<!-- Article Footer -->
            <footer class="mt-12 pt-8 border-t border-gray-700">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <a 
                        href="/#tab3"
                        class="inline-flex items-center gap-2 px-4 py-2 border border-gray-600 rounded-lg hover:text-primary hover:border-primary transition-colors"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Back to Blog
                    </a>
                    
                    <!-- Share Buttons -->
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-gray-400">Share:</span>
                        <a 
                            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`https://anikdascodes.netlify.app/blog/${postSlug}/`)}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="p-2 rounded-lg border border-gray-600 hover:text-primary hover:border-primary transition-colors"
                            aria-label="Share on Twitter"
                        >
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                            </svg>
                        </a>
                        <a 
                            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://anikdascodes.netlify.app/blog/${postSlug}/`)}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="p-2 rounded-lg border border-gray-600 hover:text-primary hover:border-primary transition-colors"
                            aria-label="Share on LinkedIn"
                        >
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </footer>
        </article>
    </main>
</Layout>

<style>
    .prose {
        @apply prose-headings:text-white prose-a:text-primary hover:prose-a:underline prose-strong:text-white;
    }
    
    /* Additional prose styles for images */
    .prose-content :global(img) {
        @apply rounded-lg border border-gray-700 max-w-full h-auto;
    }
    
    .prose-content :global(figure) {
        @apply my-8;
    }
    
    .prose-content :global(figcaption) {
        @apply text-center text-sm text-gray-400 mt-2;
    }
    
    /* Code blocks */
    .prose-content :global(pre) {
        @apply bg-gray-900 border border-gray-700 rounded-lg p-4 overflow-x-auto;
    }
    
    .prose-content :global(code) {
        @apply text-primary;
    }
    
    .prose-content :global(pre code) {
        @apply text-gray-300;
    }
    
    /* Blockquotes */
    .prose-content :global(blockquote) {
        @apply border-l-4 border-primary pl-4 italic text-gray-300;
    }
    
    /* Tables */
    .prose-content :global(table) {
        @apply w-full border-collapse my-6;
    }
    
    .prose-content :global(th),
    .prose-content :global(td) {
        @apply border border-gray-700 px-4 py-2 text-left;
    }
    
    .prose-content :global(th) {
        @apply bg-gray-800 text-white;
    }
    
    .prose-content :global(tr:nth-child(even)) {
        @apply bg-gray-900;
    }
</style>
